<Window x:Class="AudioEnhancer.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonora Pro - Precision Audio Mastering Suite by Shanveer"
        Width="1220" Height="820" MinWidth="1020" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextPriBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, sans-serif" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Border Background="{StaticResource ChassisBgBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="10" Opacity="0.85"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- 1. WINDOW TITLE BAR / HEADER (Chrome)      -->
            <!-- ========================================== -->
            <Border Grid.Row="0" Background="#0A0D12" BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand Logo + Device Route Selector -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Glyph -->
                        <Border Width="22" Height="22" CornerRadius="5" Background="#161B23"
                                BorderBrush="{StaticResource BorderCrispBrush}" BorderThickness="1" Margin="0,0,8,0">
                            <Path Data="M3 18v-6a9 9 0 0118 0v6M3 18a3 3 0 003 3h1a3 3 0 003-3v-3a3 3 0 00-3-3H3v6zm18 0a3 3 0 01-3 3h-1a3 3 0 01-3-3v-3a3 3 0 013-3h3v6z"
                                  Fill="{StaticResource AccentCyanBrush}" Width="11" Height="11" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Brand Title -->
                        <TextBlock Text="SONORA" FontSize="13.5" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO" FontSize="13.5" FontWeight="Black" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="3,0,0,0"/>

                        <!-- Creator Credit Badge -->
                        <Border Margin="8,0,0,0" CornerRadius="4" Padding="6,2" Background="#161B23"
                                BorderBrush="#232C3A" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="BY SHANVEER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"
                                       FontFamily="Segoe UI, Consolas"/>
                        </Border>

                        <!-- Divider -->
                        <Border Width="1" Height="14" Background="{StaticResource BorderSubtleBrush}" Margin="12,0,12,0" VerticalAlignment="Center"/>

                        <!-- Output Selector Dropdown -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M3 18v-6a9 9 0 0118 0v6M3 18a3 3 0 003 3h1a3 3 0 003-3v-3a3 3 0 00-3-3H3v6zm18 0a3 3 0 01-3 3h-1a3 3 0 01-3-3v-3a3 3 0 013-3h3v6z"
                                  Fill="{StaticResource AccentCyanBrush}" Width="12" Height="12" Stretch="Uniform"
                                  Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Output:" FontSize="11" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice}"
                                      Style="{StaticResource HeaderDeviceComboBox}" Width="310" VerticalAlignment="Center">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPriBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Live Audio State Indicator & Audio Format -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border CornerRadius="12" Padding="10,3" Background="#111620" BorderBrush="#1E2736"
                                BorderThickness="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#525C6D"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAudioActive}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding AudioActiveText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextCyanBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="24-BIT / 48.0 kHz" FontSize="10" Foreground="{StaticResource TextTerBrush}"
                                   FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: Window Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="MinimizeButton_Click" Style="{StaticResource WindowChromeButtonStyle}" ToolTip="Minimize">
                            <TextBlock Text="─" FontSize="11" FontWeight="Bold" Margin="0,-2,0,0"/>
                        </Button>
                        <Button Click="MaximizeButton_Click" Style="{StaticResource WindowChromeButtonStyle}" ToolTip="Maximize / Restore">
                            <TextBlock Text="□" FontSize="11" FontWeight="Bold"/>
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource WindowCloseButtonStyle}" ToolTip="Close">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2. MAIN APPLICATION CONSOLE BODY (Row 1)   -->
            <!-- ========================================== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="12,10,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*" MinWidth="340"/>
                        <ColumnDefinition Width="8*" MinWidth="580"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ==================================================== -->
                    <!-- QUADRANT 1: UPPER-LEFT - Audio Core Engine (Col 0, R0) -->
                    <!-- ==================================================== -->
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Padding="14,12" Margin="0,0,6,6">
                        <StackPanel>
                            <!-- Header: Core Engine Status -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="AUDIO CORE ENGINE" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#525C6D"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EnhancementOn}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentCyanBrush}"/>
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding EnhancementStatusText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPriBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#10151E"
                                        BorderBrush="#1F2837" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="DSP PIPELINE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextTerBrush}"
                                               FontFamily="Consolas, Segoe UI"/>
                                </Border>
                            </Grid>

                            <!-- ============================================== -->
                            <!-- 1. BIG MASTER ON/OFF POWER TOGGLE BUTTON       -->
                            <!-- ============================================== -->
                            <Button Command="{Binding TogglePowerCommand}" Cursor="Hand" Focusable="False" Margin="0,0,0,10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PowerBox" CornerRadius="10" Padding="12,9" BorderThickness="1.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Big Illuminated Power Glyph -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#111622"
                                                        BorderBrush="#1F2A3D" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <Path x:Name="PowerIcon" Data="M12,2 L12,11 M6.8,5.8 A9,9 0 1,0 17.2,5.8"
                                                          Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="2.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Status Label & Subtext -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PowerTitle" Text="{Binding EnhancementPowerButtonText}" FontSize="12.5" FontWeight="Bold"
                                                               Foreground="#FFFFFF"/>
                                                    <TextBlock x:Name="PowerSub" Text="{Binding EnhancementPowerSubtext}" FontSize="9.5"
                                                               Foreground="{StaticResource AccentCyanBrush}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <!-- Toggle Pill Switch Indicator -->
                                                <Border Grid.Column="2" x:Name="PillBd" Width="52" Height="26" CornerRadius="13"
                                                        Background="#0E2838" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1.5"
                                                        VerticalAlignment="Center">
                                                    <Border x:Name="PillThumb" Width="18" Height="18" CornerRadius="9"
                                                            Background="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right" Margin="3,0,3,0">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EnhancementOn}" Value="True">
                                                <Setter TargetName="PowerBox" Property="Background" Value="#0F2231"/>
                                                <Setter TargetName="PowerBox" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                <Setter TargetName="PowerBox" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="PowerTitle" Property="Foreground" Value="#FFFFFF"/>
                                                <Setter TargetName="PowerSub" Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                <Setter TargetName="PillBd" Property="Background" Value="#0A3247"/>
                                                <Setter TargetName="PillBd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                <Setter TargetName="PillThumb" Property="HorizontalAlignment" Value="Right"/>
                                                <Setter TargetName="PillThumb" Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EnhancementOn}" Value="False">
                                                <Setter TargetName="PowerBox" Property="Background" Value="#10141C"/>
                                                <Setter TargetName="PowerBox" Property="BorderBrush" Value="#222C3A"/>
                                                <Setter TargetName="PowerIcon" Property="Stroke" Value="{StaticResource TextTerBrush}"/>
                                                <Setter TargetName="PowerTitle" Property="Foreground" Value="{StaticResource TextSecBrush}"/>
                                                <Setter TargetName="PowerSub" Property="Foreground" Value="{StaticResource TextTerBrush}"/>
                                                <Setter TargetName="PillBd" Property="Background" Value="#141923"/>
                                                <Setter TargetName="PillBd" Property="BorderBrush" Value="#2C374A"/>
                                                <Setter TargetName="PillThumb" Property="HorizontalAlignment" Value="Left"/>
                                                <Setter TargetName="PillThumb" Property="Background" Value="#525E70"/>
                                                <Setter TargetName="PillThumb" Property="Effect" Value="{x:Null}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PowerBox" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Precision Master Dial Unit -->
                            <Grid Width="174" Height="174" HorizontalAlignment="Center" Margin="0,2,0,2">
                                <!-- Track background circle -->
                                <Path Data="M 33.3,126.7 A 66,66 0 1 1 126.7,126.7"
                                      Stroke="#1A212D" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                                <!-- Dynamic Active Cyan Glowing Arc -->
                                <Path Data="{Binding DialArcPathData}"
                                      Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                    </Path.Effect>
                                </Path>

                                <!-- Central Knurled Physical Rotary Knob -->
                                <Border Width="104" Height="104" CornerRadius="52" BorderBrush="{StaticResource BorderCrispBrush}"
                                        BorderThickness="1.5" Cursor="Hand" Background="{StaticResource KnobDialGradient}"
                                        MouseWheel="Knob_MouseWheel" MouseLeftButtonUp="Knob_MouseLeftButtonUp" MouseRightButtonUp="Knob_MouseRightButtonUp">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="8" Opacity="0.75"/>
                                    </Border.Effect>

                                    <Grid>
                                        <!-- Notch Indicator (Rotates with KnobRotationAngle) -->
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <RotateTransform Angle="{Binding KnobRotationAngle}" CenterX="52" CenterY="52"/>
                                            </Grid.RenderTransform>
                                            <Border Width="4" Height="9" CornerRadius="2" Background="{StaticResource AccentCyanBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,5,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                                </Border.Effect>
                                            </Border>
                                        </Grid>

                                        <!-- Inner Bezel (Always upright for readability) -->
                                        <Border Width="74" Height="74" CornerRadius="37" Background="#0E1116"
                                                BorderBrush="#181D26" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="LOUDNESS" FontSize="8" FontWeight="Bold"
                                                           Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding LoudnessText}" FontSize="18" FontWeight="Bold"
                                                           Foreground="#FFFFFF" FontFamily="Consolas, Segoe UI"
                                                           HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding LoudnessDbUnit}" FontSize="8.5" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Master Gain Slider Row -->
                            <StackPanel Margin="6,2,6,8">
                                <Grid Margin="0,0,0,2">
                                    <TextBlock Text="0.0 dB" FontSize="9.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left"/>
                                    <TextBlock Text="MASTER LOUDNESS GAIN" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="+36.0 dB" FontSize="9.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding VolumeDownCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Decrease Loudness (-5%)">
                                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                    <Slider Grid.Column="1" Value="{Binding Volume.Value}" Minimum="0" Maximum="100" Style="{StaticResource PrecisionHorizontalSlider}" Margin="6,0"/>
                                    <Button Grid.Column="2" Command="{Binding VolumeUpCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Increase Loudness (+5%)">
                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- ============================================== -->
                            <!-- 2. BIG VOLUME CONTROLS ROW (DOWN / MUTE / UP)  -->
                            <!-- ============================================== -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Big Volume Down Button -->
                                <Button Grid.Column="0" Command="{Binding VolumeDownCommand}" Height="36" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="DownBd" CornerRadius="8" Background="#141A24" BorderBrush="#263345" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="−" FontSize="16" FontWeight="Bold" Foreground="#889BB5" Margin="0,-2,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="VOL DOWN" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextPriBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="DownBd" Property="Background" Value="#1E2838"/>
                                                    <Setter TargetName="DownBd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="DownBd" Property="Background" Value="#0F1620"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Mute Toggle Button -->
                                <Button Grid.Column="2" Command="{Binding ToggleMuteCommand}" Height="36" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="MuteBd" CornerRadius="8" Background="#141A24" BorderBrush="#263345" BorderThickness="1" Padding="12,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"
                                                          Fill="{StaticResource TextSecBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding MuteButtonText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter TargetName="MuteBd" Property="Background" Value="#2A1616"/>
                                                    <Setter TargetName="MuteBd" Property="BorderBrush" Value="#E53E3E"/>
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="MuteBd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Big Volume Up Button -->
                                <Button Grid.Column="4" Command="{Binding VolumeUpCommand}" Height="36" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="UpBd" CornerRadius="8" Background="#0E2333" BorderBrush="#1C4B66" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="+" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,-2,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="VOL UP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="UpBd" Property="Background" Value="#14364E"/>
                                                    <Setter TargetName="UpBd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter TargetName="UpBd" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="UpBd" Property="Background" Value="#0A1C29"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- ============================================== -->
                            <!-- 3. QUICK LOUDNESS BOOST PRESET CHIPS           -->
                            <!-- ============================================== -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SetVolumeStepCommand}" CommandParameter="25" Height="25" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B25" CornerRadius="5" Background="#111620" BorderBrush="#1F2837" BorderThickness="1">
                                                <TextBlock Text="25% (QUIET)" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B25" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter TargetName="B25" Property="Background" Value="#171E2B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding SetVolumeStepCommand}" CommandParameter="50" Height="25" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B50" CornerRadius="5" Background="#111620" BorderBrush="#1F2837" BorderThickness="1">
                                                <TextBlock Text="50% (BALANCED)" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B50" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter TargetName="B50" Property="Background" Value="#171E2B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="4" Command="{Binding SetVolumeStepCommand}" CommandParameter="75" Height="25" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B75" CornerRadius="5" Background="#111620" BorderBrush="#1F2837" BorderThickness="1">
                                                <TextBlock Text="75% (LOUD)" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B75" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter TargetName="B75" Property="Background" Value="#171E2B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Grid.Column="6" Command="{Binding SetVolumeStepCommand}" CommandParameter="100" Height="25" Cursor="Hand" Focusable="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="B100" CornerRadius="5" Background="#111620" BorderBrush="#1F2837" BorderThickness="1">
                                                <TextBlock Text="MAX (100%)" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="B100" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter TargetName="B100" Property="Background" Value="#171E2B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <!-- ============================================== -->
                            <!-- 4. BOTTOM METRIC READOUT CHIPS (3 chips)       -->
                            <!-- ============================================== -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- True Peak -->
                                <Border Grid.Column="0" Background="#0A0D12" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="6,5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="TRUE PEAK" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PeakDbText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPriBrush}"
                                                   FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- RMS Energy -->
                                <Border Grid.Column="2" Background="#0A0D12" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="6,5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="RMS ENERGY" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding RmsDbText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCyanBrush}"
                                                   FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Dynamic Headroom -->
                                <Border Grid.Column="4" Background="#0A0D12" CornerRadius="8" BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1" Padding="6,5">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="HEADROOM" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding DynamicHeadroomText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource LedGreenBrush}"
                                                   FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ==================================================================== -->
                    <!-- QUADRANT 2: UPPER-RIGHT - Real-Time FFT Analyzer & Presets (Col 1, R0) -->
                    <!-- ==================================================================== -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,6">
                        <!-- Card 1: Real-Time Audio Spectrum Analyzer -->
                        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Height="255">
                            <StackPanel>
                                <!-- Analyzer Header -->
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <TextBlock Text="HIGH-RESOLUTION REAL-TIME FFT ANALYZER" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPriBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text=" • 20 Hz — 20 kHz • 2048 SAMPLES" FontSize="9.5"
                                                   Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Mode Badges -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#1A2230" BorderBrush="#2A374C" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="PEAK + RTA" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <Border Background="#0A0E14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="SIGNAL: " FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}"/>
                                                <TextBlock Text="{Binding AudioSignalText}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource LedGreenBrush}"
                                                           FontFamily="Consolas, Segoe UI"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Visualizer Screen Well -->
                                <Border Background="{StaticResource WellBgBrush}" BorderBrush="{StaticResource WellBorderBrush}"
                                        BorderThickness="1" CornerRadius="8" ClipToBounds="True" Height="165">
                                    <Grid>
                                        <!-- Reference Grid Guidelines -->
                                        <Grid Margin="6,4,6,22" IsHitTestVisible="False">
                                            <!-- +12 dB -->
                                            <Grid VerticalAlignment="Top" Margin="0,8,0,0">
                                                <Border Height="1" Background="#1E2736"/>
                                                <TextBlock Text="+12 dB" FontSize="7.5" Foreground="#525C6D" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left" Margin="0,-10,0,0"/>
                                                <TextBlock Text="OVERLOAD CEILING" FontSize="7.5" Foreground="#404B5C" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" Margin="0,-10,0,0"/>
                                            </Grid>
                                            <!-- 0 dB -->
                                            <Grid VerticalAlignment="Top" Margin="0,42,0,0">
                                                <Border Height="1" Background="#18202D"/>
                                                <TextBlock Text="0 dB" FontSize="7.5" Foreground="#525C6D" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left" Margin="0,-10,0,0"/>
                                                <TextBlock Text="TARGET HARMONIC REFERENCE" FontSize="7.5" Foreground="#404B5C" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" Margin="0,-10,0,0"/>
                                            </Grid>
                                            <!-- -18 dB -->
                                            <Grid VerticalAlignment="Top" Margin="0,80,0,0">
                                                <Border Height="1" Background="#141A24"/>
                                                <TextBlock Text="-18 dB" FontSize="7.5" Foreground="#525C6D" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left" Margin="0,-10,0,0"/>
                                                <TextBlock Text="OPTIMAL DYNAMIC LEVEL" FontSize="7.5" Foreground="#404B5C" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" Margin="0,-10,0,0"/>
                                            </Grid>
                                            <!-- -36 dB -->
                                            <Grid VerticalAlignment="Top" Margin="0,118,0,0">
                                                <Border Height="1" Background="#10151E"/>
                                                <TextBlock Text="-36 dB" FontSize="7.5" Foreground="#404B5C" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left" Margin="0,-10,0,0"/>
                                                <TextBlock Text="NOISE FLOOR" FontSize="7.5" Foreground="#323C4D" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" Margin="0,-10,0,0"/>
                                            </Grid>
                                        </Grid>

                                        <!-- Real-time SVG Canvas Graphic Display -->
                                        <Viewbox Stretch="Fill" Margin="2,0,2,22">
                                            <Grid Width="800" Height="160">
                                                <!-- 32 RTA Vertical Micro-Bars -->
                                                <Path Data="{Binding SpectrumBarsPathData}" Fill="{StaticResource AccentCyanBrush}" Opacity="0.32"/>

                                                <!-- Continuous Density Area Fill Under Curve -->
                                                <Path Data="{Binding SpectrumFillPathData}" Fill="{StaticResource SpectrumGrad}"/>

                                                <!-- Continuous Spectral Spline Line -->
                                                <Path Data="{Binding SpectrumLinePathData}" Stroke="{StaticResource CurveStroke}"
                                                      StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                                    </Path.Effect>
                                                </Path>
                                            </Grid>
                                        </Viewbox>

                                        <!-- Bottom Frequency Division Axis (20 Hz to 20 kHz) -->
                                        <Border VerticalAlignment="Bottom" Background="#090C10" BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="0,1,0,0" Padding="8,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="20 Hz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="63 Hz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="125 Hz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="250 Hz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="500 Hz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="1 kHz" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="6" Text="2 kHz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="7" Text="4 kHz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="8" Text="8 kHz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="9" Text="16 kHz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="10" Text="20 kHz" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Zone Tags -->
                                <Grid Margin="4,5,4,0">
                                    <TextBlock Text="SUB-BASS (20-60Hz)" FontSize="8" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Left"/>
                                    <TextBlock Text="PUNCH BASS (60-250Hz)" FontSize="8" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="-160,0,0,0"/>
                                    <TextBlock Text="VOCAL PRESENCE (1-4kHz)" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" Margin="140,0,0,0"/>
                                    <TextBlock Text="AIR &amp; BRILLIANCE (8-20kHz)" FontSize="8" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Acoustic Preset Profiles Row -->
                        <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,8,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="ACOUSTIC PRESET PROFILES" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Left"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="ACTIVE: " FontSize="9.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI"/>
                                        <TextBlock Text="{Binding ActivePresetHeader}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas, Segoe UI"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Segmented Presets ListBox -->
                                <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                                         ItemContainerStyle="{StaticResource PresetListBoxItemStyle}"
                                         Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="8"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- QUADRANT 3: LOWER-LEFT - Acoustic Dynamics (Col 0, R1)   -->
                    <!-- ======================================================== -->
                    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Padding="14,12" Margin="0,6,6,0">
                        <StackPanel>
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="ACOUSTIC DYNAMICS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Text="PRECISION DSP" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Fader 1: Bass Boost -->
                            <StackPanel Margin="0,0,0,10">
                                <Grid Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Bass Boost" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPriBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding BassDbText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCyanBrush}"
                                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding BassDownCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Decrease Bass (-5%)">
                                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                    <Slider Grid.Column="1" Value="{Binding Bass.Value}" Minimum="0" Maximum="100" Style="{StaticResource PrecisionHorizontalSlider}" Margin="6,0"/>
                                    <Button Grid.Column="2" Command="{Binding BassUpCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Increase Bass (+5%)">
                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                    <TextBlock Text="Neutral" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Subharmonic Punch" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="+12 dB" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Fader 2: Clarity -->
                            <StackPanel Margin="0,0,0,10">
                                <Grid Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Clarity" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPriBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ClarityDbText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCyanBrush}"
                                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding ClarityDownCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Decrease Clarity (-5%)">
                                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                    <Slider Grid.Column="1" Value="{Binding Clarity.Value}" Minimum="0" Maximum="100" Style="{StaticResource PrecisionHorizontalSlider}" Margin="6,0"/>
                                    <Button Grid.Column="2" Command="{Binding ClarityUpCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Increase Clarity (+5%)">
                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                    <TextBlock Text="Warm" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Vocal Intelligibility" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Crisp" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Fader 3: Surround Virtualization -->
                            <StackPanel Margin="0,0,0,10">
                                <Grid Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Surround Virtualization" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPriBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SurroundText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCyanBrush}"
                                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding DetailDownCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Decrease Surround (-5%)">
                                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                    <Slider Grid.Column="1" Value="{Binding Detail.Value}" Minimum="0" Maximum="100" Style="{StaticResource PrecisionHorizontalSlider}" Margin="6,0"/>
                                    <Button Grid.Column="2" Command="{Binding DetailUpCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Increase Surround (+5%)">
                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                    <TextBlock Text="Studio Direct" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Binaural Spatializer" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Immersive" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Fader 4: Dynamic Range Control -->
                            <StackPanel Margin="0,0,0,12">
                                <Grid Margin="0,0,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dynamic Range Control" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPriBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DrcText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextCyanBrush}"
                                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding VoiceDownCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Decrease Dynamic Range Control (-5%)">
                                        <TextBlock Text="−" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                    <Slider Grid.Column="1" Value="{Binding Voice.Value}" Minimum="0" Maximum="100" Style="{StaticResource PrecisionHorizontalSlider}" Margin="6,0"/>
                                    <Button Grid.Column="2" Command="{Binding VoiceUpCommand}" Style="{StaticResource MiniStepButtonStyle}" ToolTip="Increase Dynamic Range Control (+5%)">
                                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Margin="0,-1,0,0"/>
                                    </Button>
                                </Grid>
                                <Grid Margin="0,1,0,0">
                                    <TextBlock Text="Full Dynamic" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="Smart Leveling" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Compressed" FontSize="8.5" Foreground="{StaticResource TextTerBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>

                            <!-- Footer: Tube Warmth & Reset Defaults -->
                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Harmonic Saturation: " FontSize="9.5" Foreground="{StaticResource TextSecBrush}"/>
                                        <TextBlock Text="Tube Warmth" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextPriBrush}"/>
                                    </StackPanel>
                                    <Button HorizontalAlignment="Right" Command="{Binding ResetDefaultsCommand}" Cursor="Hand" Background="Transparent"
                                            BorderThickness="0" Focusable="False">
                                        <TextBlock Text="Reset Defaults" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" TextDecorations="Underline"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ============================================================= -->
                    <!-- QUADRANT 4: LOWER-RIGHT - 11-Band Precision Equalizer (Col 1, R1) -->
                    <!-- ============================================================= -->
                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="12"
                            Padding="14,12" Margin="6,6,0,0">
                        <StackPanel>
                            <!-- EQ Header -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00D2FF" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="11-BAND PRECISION MASTERING EQUALIZER" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextPriBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" • ±12.0 dB LINEAR PHASE FILTERING" FontSize="9.5"
                                               Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Flatten & Acoustic Curve Buttons -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding FlattenEqCommand}" Cursor="Hand" Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="FlBd" Background="#161C26" BorderBrush="#242E3E" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                                    <TextBlock x:Name="FlTxt" Text="Flatten" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextSecBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="FlBd" Property="Background" Value="#1E2634"/>
                                                        <Setter TargetName="FlTxt" Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Command="{Binding AcousticCurveCommand}" Cursor="Hand" Focusable="False" Margin="6,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="AcBd" Background="#161C26" BorderBrush="#242E3E" BorderThickness="1" CornerRadius="6" Padding="10,3">
                                                    <TextBlock x:Name="AcTxt" Text="Acoustic Curve" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="AcBd" Property="Background" Value="#1E2634"/>
                                                        <Setter TargetName="AcTxt" Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Filter Response Curve Preview -->
                            <Border Height="36" Background="{StaticResource WellBgBrush}" BorderBrush="{StaticResource WellBorderBrush}"
                                    BorderThickness="1" CornerRadius="6" ClipToBounds="True" Margin="0,0,0,10">
                                <Grid Margin="4,2">
                                    <!-- Center 0dB dashed line -->
                                    <Line X1="0" Y1="17" X2="600" Y2="17" Stroke="#252F3E" StrokeThickness="1" StrokeDashArray="2,2"/>

                                    <!-- Rendered EQ Spline Path -->
                                    <Viewbox Stretch="Fill">
                                        <Path Data="{Binding EqCurvePathData}" Stroke="{StaticResource AccentCyanBrush}"
                                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    </Viewbox>

                                    <TextBlock Text="FILTER RESPONSE CURVE" FontSize="7.5" Foreground="{StaticResource TextTerBrush}"
                                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0"/>
                                </Grid>
                            </Border>

                            <!-- 11 Sliders Rack Grid -->
                            <Border Background="#0A0D12" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="6,8">
                                <ItemsControl ItemsSource="{Binding FrequencyBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" Columns="11"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Center">
                                                <!-- Readout -->
                                                <TextBlock Text="{Binding GainDbText}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextCyanBrush}" HorizontalAlignment="Center"
                                                           FontFamily="Consolas, Segoe UI" Margin="0,0,0,4"/>
                                                <!-- Vertical Slider -->
                                                <Slider Orientation="Vertical" Minimum="-12" Maximum="12"
                                                        Value="{Binding SliderValue, Mode=TwoWay}"
                                                        Style="{StaticResource EqVerticalSlider}" Height="100" HorizontalAlignment="Center"/>
                                                <!-- Band Label -->
                                                <TextBlock Text="{Binding Label}" FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextSecBrush}" HorizontalAlignment="Center"
                                                           FontFamily="Consolas, Segoe UI" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- ========================================== -->
            <!-- 3. WINDOW STATUS FOOTER (Row 2)            -->
            <!-- ========================================== -->
            <Border Grid.Row="2" Background="#080A0E" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <!-- Left Status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource LedGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="AUDIO ENGINE: READY" FontSize="9.5" Foreground="{StaticResource TextSecBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="9.5" Foreground="{StaticResource TextTerBrush}" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="DEVICE: " FontSize="9.5" Foreground="{StaticResource TextSecBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OutputDeviceName}" FontSize="9.5" Foreground="{StaticResource TextPriBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="|" FontSize="9.5" Foreground="{StaticResource TextTerBrush}" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="PROFILE: " FontSize="9.5" Foreground="{StaticResource TextSecBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedPresetName}" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right Brand Signature -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="DSP LATENCY: &lt;1.8ms" FontSize="9.5" Foreground="{StaticResource TextSecBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                        <TextBlock Text="|" FontSize="9.5" Foreground="{StaticResource TextTerBrush}" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="SONORA PRECISION AUDIO MASTERING SUITE • ENGINEERED BY SHANVEER" FontSize="9.5" Foreground="{StaticResource TextTerBrush}" FontFamily="Consolas, Segoe UI" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
