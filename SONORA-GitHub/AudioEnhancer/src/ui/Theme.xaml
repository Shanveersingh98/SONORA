    <!-- ===== Studio Master Power Rocker / Pill Switch ===== -->
    <Style x:Key="StudioPowerSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Width" Value="94"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="18" Background="#141B28" BorderBrush="#25324D" BorderThickness="1.5">
                        <Grid>
                            <!-- OFF Content -->
                            <TextBlock x:Name="OffText" Text="BYPASS" FontSize="10.5" FontWeight="Bold" Foreground="#6C7A9C"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>

                            <!-- ON Content -->
                            <TextBlock x:Name="OnText" Text="ACTIVE" FontSize="10.5" FontWeight="Bold" Foreground="#0A1812"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0"/>

                            <!-- Tactile Thumb Pill with Power Glyph -->
                            <Border x:Name="Thumb" Width="28" Height="28" CornerRadius="14"
                                    Background="#222B3E" HorizontalAlignment="Left" Margin="4,0,0,0"
                                    BorderBrush="#384666" BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="2" Opacity="0.5"/>
                                </Border.Effect>
                                <Path x:Name="PowerIcon" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M6,1 L6,6 M3.4,3 A4.5,4.5 0 1,0 8.6,3"
                                      Stroke="#7E8BA6" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="11" Height="11" Stretch="Uniform"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#3D507A"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource EmeraldCyanGradient}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#00F5A0"/>
                            <Setter TargetName="Track" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00F5A0" BlurRadius="12" ShadowDepth="0" Opacity="0.45"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="OffText" Property="Opacity" Value="0"/>
                            <Setter TargetName="OnText" Property="Opacity" Value="1"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0"/>
                            <Setter TargetName="Thumb" Property="Background" Value="#FFFFFF"/>
                            <Setter TargetName="Thumb" Property="BorderBrush" Value="#00F5A0"/>
                            <Setter TargetName="PowerIcon" Property="Stroke" Value="#00C875"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Legacy / Alias PowerButton style forwarding to clean studio toggle -->
    <Style x:Key="PowerButton" TargetType="ToggleButton" BasedOn="{StaticResource StudioPowerSwitch}"/>

    <!-- ===== Luxury Preset Chip Card (Multi-Color Badge) ===== -->
    <Style x:Key="PresetChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="CardBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}"
                            Width="92" Height="78">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextBrush}"
                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="9.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource CyanBlueGradient}"/>
                            <Setter TargetName="CardBorder" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CardBorder" Property="Background" Value="#172238"/>
                            <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource EmeraldCyanGradient}"/>
                            <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                            <Setter TargetName="CardBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00F5A0" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Compact ToggleSwitch ===== -->
    <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="44" Height="24">
                        <Border x:Name="Track" CornerRadius="12" Background="{StaticResource TrackBrush}"/>
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{StaticResource TextBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource EmeraldCyanGradient}"/>
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Dark ComboBox ===== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" Margin="4,2">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box" Background="{StaticResource RaisedBrush}"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                                              Data="M0,0 L4,4 L8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource MutedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="14,0,34,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="280" Margin="0,4,0,0" CornerRadius="8"
                                    Background="{StaticResource RaisedBrush}"
                                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" Margin="0,2"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Master Suite Studio Dark Palette & Control Styles ===== -->
    <SolidColorBrush x:Key="ChassisBgBrush"     Color="#07090C"/>
    <SolidColorBrush x:Key="PanelBgBrush"       Color="#12161E"/>
    <SolidColorBrush x:Key="PanelBorderBrush"   Color="#212938"/>
    <SolidColorBrush x:Key="SurfaceBgBrush"     Color="#171B23"/>
    <SolidColorBrush x:Key="WellBgBrush"        Color="#0A0D12"/>
    <SolidColorBrush x:Key="WellBorderBrush"    Color="#1A202C"/>
    <SolidColorBrush x:Key="AccentCyanBrush"    Color="#00D2FF"/>
    <SolidColorBrush x:Key="LedGreenBrush"      Color="#10B981"/>
    <SolidColorBrush x:Key="TextPriBrush"       Color="#F0F3F8"/>
    <SolidColorBrush x:Key="TextSecBrush"       Color="#8A94A6"/>
    <SolidColorBrush x:Key="TextCyanBrush"      Color="#89D5FF"/>
    <SolidColorBrush x:Key="TextTerBrush"       Color="#525C6D"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#1C222D"/>
    <SolidColorBrush x:Key="BorderCrispBrush"   Color="#2A3242"/>

    <LinearGradientBrush x:Key="CurveStroke" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E5FF" Offset="0.0"/>
        <GradientStop Color="#00A2FF" Offset="0.5"/>
        <GradientStop Color="#7B61FF" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SpectrumGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8000D2FF" Offset="0.0"/>
        <GradientStop Color="#330066FF" Offset="0.6"/>
        <GradientStop Color="#00002244" Offset="1.0"/>
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="KnobDialGradient" Center="0.45,0.35" GradientOrigin="0.45,0.35" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#242B38" Offset="0.0"/>
        <GradientStop Color="#151922" Offset="0.65"/>
        <GradientStop Color="#0F1218" Offset="1.0"/>
    </RadialGradientBrush>

    <!-- Precision Horizontal Fader Style -->
    <Style x:Key="PrecisionHorizontalThumb" TargetType="Thumb">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#E1E7F0" BorderBrush="#717F96" BorderThickness="1" CornerRadius="2" Width="10" Height="18">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Border Width="1.5" Height="10" Background="#717F96" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mini Step Button Style for Fader Decrement/Increment -->
    <Style x:Key="MiniStepButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Background" Value="#141A24"/>
        <Setter Property="BorderBrush" Value="#253244"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#889BB5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E2838"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0F1620"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrecisionHorizontalSlider" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="4" CornerRadius="2" Background="#1B212C" BorderBrush="#232B3A" BorderThickness="1" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PrecisionHorizontalThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Grid Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 11-Band EQ Vertical Hardware Fader Style -->
    <Style x:Key="EqVerticalThumb" TargetType="Thumb">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="#E1E7F0" BorderBrush="#717F96" BorderThickness="1" CornerRadius="2" Width="18" Height="10">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <Border Width="10" Height="1.5" Background="#717F96" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#00D2FF" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EqVerticalSlider" TargetType="Slider">
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="Minimum" Value="-12"/>
        <Setter Property="Maximum" Value="12"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Width="4" CornerRadius="2" Background="#1B212C" BorderBrush="#232B3A" BorderThickness="1" HorizontalAlignment="Center"/>
                        <Border Height="1" Width="14" Background="#364359" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource EqVerticalThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Preset Segmented Button Style -->
    <Style x:Key="PresetListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="#0F131A"/>
        <Setter Property="BorderBrush" Value="#1E2634"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Padding" Value="4,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="Txt" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="#8A94A6" HorizontalAlignment="Center"/>
                            <Ellipse x:Name="Dot" Width="4" Height="4" Margin="0,4,0,0" Fill="Transparent" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#161C26"/>
                            <Setter TargetName="Txt" Property="Foreground" Value="#F0F3F8"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1B2638"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                            <Setter TargetName="Txt" Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                            <Setter TargetName="Txt" Property="FontWeight" Value="Bold"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AccentCyanBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titlebar Window Chrome Buttons -->
    <Style x:Key="WindowChromeButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8A94A6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A222E"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#8A94A6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Device ComboBox Style -->
    <Style x:Key="HeaderDeviceComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="#F0F3F8"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box" Background="#131720"
                                            BorderBrush="#232B3A" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                        <Grid>
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                                                  Data="M0,0 L3.5,3.5 L7,0" Stroke="#8A94A6" StrokeThickness="1.5"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="Background" Value="#181E29"/>
                                            <Setter TargetName="Box" Property="BorderBrush" Value="#323F54"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="8,0,24,0"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="260" Margin="0,4,0,0" CornerRadius="6"
                                    Background="#131720"
                                    BorderBrush="#232B3A" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True" Margin="0,2"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
