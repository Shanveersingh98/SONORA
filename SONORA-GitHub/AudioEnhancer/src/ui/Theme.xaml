<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Core Theme Colors ===== -->
    <SolidColorBrush x:Key="BgBrush"        Color="#0A0D15"/>
    <SolidColorBrush x:Key="CardBrush"      Color="#121724"/>
    <SolidColorBrush x:Key="RaisedBrush"    Color="#192033"/>
    <SolidColorBrush x:Key="LineBrush"      Color="#232C42"/>
    <SolidColorBrush x:Key="HoverBrush"     Color="#2D3854"/>
    <SolidColorBrush x:Key="TrackBrush"     Color="#1E2538"/>
    <SolidColorBrush x:Key="TextBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush"     Color="#7E8BA6"/>
    <SolidColorBrush x:Key="AccentBrush"    Color="#00F2FE"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#0B3047"/>
    <SolidColorBrush x:Key="ErrorBrush"     Color="#FF4757"/>

    <!-- ===== Vibrant Multi-Color Neon Accents ===== -->
    <SolidColorBrush x:Key="NeonCyan"       Color="#00F2FE"/>
    <SolidColorBrush x:Key="NeonViolet"     Color="#B026FF"/>
    <SolidColorBrush x:Key="NeonEmerald"    Color="#00F5A0"/>
    <SolidColorBrush x:Key="NeonPink"       Color="#FF2A6D"/>
    <SolidColorBrush x:Key="NeonAmber"      Color="#FF9F43"/>
    <SolidColorBrush x:Key="NeonGold"       Color="#FFD200"/>

    <!-- ===== Multi-Color Linear Gradients ===== -->
    <LinearGradientBrush x:Key="CyanBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F2FE" Offset="0.0"/>
        <GradientStop Color="#4FACFE" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="VioletMagentaGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B026FF" Offset="0.0"/>
        <GradientStop Color="#FF007F" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmeraldCyanGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00F5A0" Offset="0.0"/>
        <GradientStop Color="#00D9F5" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GoldAmberGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE066" Offset="0.0"/>
        <GradientStop Color="#FF8008" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PinkPurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2A6D" Offset="0.0"/>
        <GradientStop Color="#9B51E0" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Spectrum Bar Multi-Stop Vertical Gradient -->
    <LinearGradientBrush x:Key="SpectrumBarBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#00F2FE" Offset="0.0"/>
        <GradientStop Color="#7B2CBF" Offset="0.45"/>
        <GradientStop Color="#FF007F" Offset="0.85"/>
        <GradientStop Color="#FF5252" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Card Glass Gradient Fill -->
    <LinearGradientBrush x:Key="CardGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#161C2C" Offset="0.0"/>
        <GradientStop Color="#101522" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardBorderGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#323F60" Offset="0.0"/>
        <GradientStop Color="#1A2135" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- ===== Text + Card Styles ===== -->
    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="StatusValue" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorderGradient}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Modern Illuminated Slider Controls ===== -->
    <Style x:Key="SliderFillButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource CyanBlueGradient}" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#00F2FE" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderEmptyButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse Width="20" Height="20" Fill="#1E2538" Stroke="{StaticResource CyanBlueGradient}" StrokeThickness="2.5">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00F2FE" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="6" Height="6" Fill="#FFFFFF"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Width" Value="22"/>
                            <Setter Property="Height" Value="22"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Width" Value="22"/>
                            <Setter Property="Height" Value="22"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="TickFrequency" Value="1"/>
        <Setter Property="IsSnapToTickEnabled" Value="True"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButton}"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButton}"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

