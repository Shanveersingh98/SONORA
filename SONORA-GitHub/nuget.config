<?xml version="1.0" encoding="utf-8"?>
<!-- The DSP library and its tests have zero NuGet dependencies.
     Clearing the sources keeps restore fully offline. Delete this file if you
     later add a package (NAudio for Part 2B, for example). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
